# AWS authentication is provided by the EC2 instance role in production.
# For local development set AWS_PROFILE, or use short-lived standard AWS credentials.
AWS_REGION=eu-west-1
AWS_PROFILE=vp-development

VP_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/ACCOUNT_ID/vp-execution-sqs
VP_DLQ_URL=https://sqs.eu-west-1.amazonaws.com/ACCOUNT_ID/vp-execution-sqs-dlq

VP_BACKEND_BASE_URL=https://backend.example.com

VP_JWT_KEY_ID=vp-runner-2026-01
# Local development path. In production mount the key under /run/secrets.
VP_JWT_PRIVATE_KEY_FILE=./vp-runner-private.pem
VP_JWT_ISSUER=vp-runner
VP_JWT_SUBJECT=vp-runner-production
VP_JWT_AUDIENCE=workflow-backend

VP_REQUEST_TIMEOUT_MS=10000
VP_VISIBILITY_TIMEOUT_SECONDS=120
VP_MAX_ATTEMPTS=5
VP_HEALTH_PORT=9100

# HTTP proof of concept: use npm run start:http-demo (port 9101).
# The backend signs delivery requests with its own development private key;
# the worker needs only the matching public key.
VP_EVENT_TRANSPORT=sqs
VP_INBOUND_JWT_KEY_ID=vp-backend-events-dev-1
VP_INBOUND_JWT_PUBLIC_KEY_FILE=./vp-backend-events-public.pem

# Generated-JS mode runs the snapshotted Blockly JavaScript in a separate,
# credential-free sandbox container. Do not enable until the backend framework
# and operationReceipts migration have been deployed.
VP_PROGRAM_MODE=log
VP_SANDBOX_URL=http://vp-sandbox:9200
